generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @db.Uuid
  firstName    String   @map("first_name") @db.VarChar(50)
  lastName     String   @map("last_name") @db.VarChar(50)
  username     String   @unique @db.VarChar(30)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.Text
  quizzes      Quiz[]
  hostedRooms  Room[]
  participations Participant[]
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model Quiz {
  id            String      @id @default(uuid()) @db.Uuid
  title         String      @db.VarChar(120)
  status        QuizStatus   @default(draft)
  ownerId       String      @map("owner_id") @db.Uuid
  owner         User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  questions     Question[]
  rooms         Room[]
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  

  @@index([ownerId, status])
  @@map("quizzes")
}

model Question {
  id            String   @id @default(uuid()) @db.Uuid

  quizId        String   @map("quiz_id") @db.Uuid
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  text          String   @db.Text
  codeSnippet   String?  @map("code_snippet") @db.Text

  optionA       String   @map("option_a") @db.Text
  optionB       String   @map("option_b") @db.Text
  optionC       String   @map("option_c") @db.Text
  optionD       String   @map("option_d") @db.Text

  correctOption String   @map("correct_option")
  participantAnswers ParticipantAnswer[]
  timeLimitSeconds Int   @map("time_limit_seconds")
  orderIndex       Int   @map("order_index")

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([quizId, orderIndex])
  @@map("questions")
}

enum QuizStatus {
  draft
  published
  archived
}

enum RoomStatus {
  waiting
  in_progress
  completed
}

model Room {
  id             String     @id @default(uuid()) @db.Uuid
  quizId         String     @map("quiz_id") @db.Uuid
  hostUserId     String     @map("host_user_id") @db.Uuid
  inviteToken    String     @unique @map("invite_token")
  allowAnonymous Boolean    @default(true) @map("allow_anonymous")
  status         RoomStatus @default(waiting)
  startedAt      DateTime?  @map("started_at")
  endedAt        DateTime?  @map("ended_at")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  participants Participant[]

  quiz           Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  hostUser       User       @relation(fields: [hostUserId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([hostUserId])
  @@index([status])
  @@map("rooms")
}

enum ParticipantConnectionStatus {
  connected
  disconnected
}

model Participant {
  id             String                        @id @default(uuid()) @db.Uuid
  roomId         String                        @map("room_id") @db.Uuid
  room           Room                          @relation(fields: [roomId], references: [id], onDelete: Cascade)

  // Nullable — anonymous participants (PRD §6) have no User row.
  userId         String?                       @map("user_id") @db.Uuid
  user           User?                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName    String                        @map("display_name") @db.VarChar(50)
  answers ParticipantAnswer[]
  connectionStatus ParticipantConnectionStatus @default(connected) @map("connection_status")

  joinedAt       DateTime                      @default(now()) @map("joined_at") @db.Timestamptz(6)
  disconnectedAt DateTime?                     @map("disconnected_at")

  @@index([roomId])
  @@index([roomId, userId])
  @@map("participants")
}

model ParticipantAnswer {
  id              String      @id @default(uuid()) @db.Uuid

  participantId   String      @map("participant_id") @db.Uuid
  participant     Participant @relation(fields: [participantId],references: [id], onDelete: Cascade)

  questionId String      @map("question_id") @db.Uuid
  question       Question    @relation(fields: [questionId],references: [id],onDelete: Cascade)

  selectedOption  String?     @map("selected_option") @db.VarChar(1)
  isCorrect       Boolean     @map("is_correct")
  timeTakenMs     Int         @map("time_taken_ms")
  answeredAt      DateTime    @default(now()) @map("answered_at") @db.Timestamptz(6)

  @@unique([participantId, questionId])
  @@index([participantId])
  @@index([questionId])
  @@map("participant_answers")
}

